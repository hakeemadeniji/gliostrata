# Copy this file to .env and fill in values as needed.
# All values are OPTIONAL — the project runs on public data without any of these.

# TCGA / GDC access (only needed for controlled-access data)
# Apply at: https://dbgap.ncbi.nlm.nih.gov/aa/wga.cgi
DBGAP_API_KEY=

# BU Shared Computing Cluster (only needed if running on SCC)
SCC_USERNAME=
SCC_PROJECT_DIR=

# MLflow tracking (only needed for experiment tracking)
MLFLOW_TRACKING_URI=

# OSF pre-registration (only needed for protocol registration)
OSF_TOKEN=

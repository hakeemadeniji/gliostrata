# Paths DVC must never hash, cache, or push to a remote.
# Same syntax as .gitignore.

# ── Download scratch ──────────────────────────────────────────────────────
# Per-sample STAR gene-count TSVs pulled from the GDC by
# scripts/download_tcga_expression.py. ~1.2 GB for the full TCGA-GBM cohort,
# and fully reconstructible from the GDC file_manifest.parquet, which IS
# tracked. Caching it would double 1.2 GB on disk and push it to a remote for
# no provenance gain.
# The same rule covers the MGMT/IDH download caches:
#   data/raw/tcga_gbm/methylation/_cache/   ~2.3 GB of raw beta-value files
#   data/raw/tcga_gbm/mutations/_cache/     ~19 MB of masked somatic MAFs
data/raw/**/_cache/
data/raw/**/*.tsv.gz
data/raw/**/*.tar.gz

# ── Frozen partition manifests live in GIT, not DVC ───────────────────────
# Sealed train/test splits must be reviewable in a diff and must never be
# regenerated by a pipeline run. See docs/reproducibility.md.
data/partitions/

# ── Caches, scratch and build output ──────────────────────────────────────
.snakemake/
.test/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.benchmarks/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# ── Environments and secrets ──────────────────────────────────────────────
.venv/
venv/
.env
.env.local

# ── OS / editor cruft ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db
~$*
*.swp

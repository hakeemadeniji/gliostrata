# Data (large files — versioned via DVC, not git)
#
# The three large artifacts below are ALREADY covered by the glob rules that
# follow. They are listed here only so nobody has to rediscover them, and so
# nobody adds a duplicate rule:
#   data/raw/tcga_gbm/expression/_cache/      1.2 GB  per-sample STAR TSVs,
#                                                     re-downloadable from the GDC
#   data/raw/tcga_gbm/expression/tpm.parquet   67 MB  derived matrix
#   data/processed/cibersortx/*.txt            39 MB  CIBERSORTx mixture export,
#                                                     regenerable in seconds from
#                                                     tpm.parquet via
#                                                     scripts/export_cibersortx.py
# Added by the MGMT/IDH ingest (both under data/raw/**, no rule needed):
#   data/raw/tcga_gbm/methylation/_cache/   ~2.3 GB  raw 27k/450k beta-value files
#   data/raw/tcga_gbm/mutations/_cache/      ~19 MB  masked somatic MAFs
#   (the small call tables next to them are also git-ignored by data/raw/**;
#    they are DVC-tracked through the ingest_tcga_mutations and
#    ingest_tcga_methylation stages in dvc.yaml. The *_report.json files and
#    the caches are not tracked by either.)
# Verify with `git check-ignore -v <path>` rather than by adding a rule.
data/raw/**
data/interim/**
data/processed/**
data/external/**
data/manual/**
data/results/**
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!data/results/.gitkeep

# data/partitions/ is DELIBERATELY NOT IGNORED.
# Frozen train/test manifests are a pre-registration commitment: they must be
# reviewable in a diff, must travel with the code, and must never be
# regenerated by a pipeline run. They are kilobytes of JSON. Do not add
# data/partitions to this file, and do not make it a DVC out (see .dvcignore).
# tests/test_workflow.py fails if either happens.

# Models (large files — versioned via DVC)
models/**
!models/.gitkeep

# DVC
/.dvc/cache
/.dvc/tmp

# Snakemake
.snakemake/
snakemake_logs/
dag.svg

# Offline fixture pipeline output (`make pipeline-fixture`, CI). Repo-relative
# on purpose: Snakemake's metadata store cannot handle long absolute
# out-of-tree paths on Windows.
.test/

# Notebooks
.ipynb_checkpoints/

# Env
.env
.env.local

# OS
Thumbs.db

# Office lock/temp files
~$*

# The result files the pre-registration cites by path. They are summary statistics already
# published in sections 2.3 and 2.4 plus 100 SIMULATED mixtures, with no patient-level data,
# and a registration that names a file must ship it or the citation is unverifiable.
# Everything else under data/results/ stays ignored.
#
# The two directory negations are required, not decorative: git will not re-include a file
# whose parent directory is excluded, and `data/results/**` excludes the directories too.
!data/results/cgga/
!data/results/t1/
data/results/cgga/**
data/results/t1/**
!data/results/cgga/cox_external_validation.json
!data/results/cgga/brier18_external.json
!data/results/t1/neftel_mixture_deconvolution.json
!data/results/t1/neftel_mixture_deconvolution_mixtures.parquet
